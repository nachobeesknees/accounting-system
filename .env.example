# Postgres connection string. Local Postgres or Neon's pooled endpoint
# both work — the app speaks the standard wire protocol via postgres-js.
DATABASE_URL=postgres://localhost:5432/thistlewood

# 32+ random bytes used by Auth.js to sign/encrypt JWT session cookies.
# Generate with `openssl rand -base64 32`.
AUTH_SECRET=

# One-click passwordless demo picker (admin / accountant / viewer). While
# true, the three thistlewood demo accounts sign in without a password
# check. The production demo runs with this on; flip to false once real
# per-user credentials are the policy.
ENABLE_DEMO_LOGIN=true

# Temporary local migration escape hatch for old `$demo$` password sentinels.
# Do not enable in production.
ALLOW_LEGACY_DEMO_PASSWORDS=false

# Sentry DSN for client + server error reporting. Leave empty to run
# without telemetry — the SDK is wired up but no-ops when this is unset.
NEXT_PUBLIC_SENTRY_DSN=

# Required in production for /api/cron/recurring-invoices.
CRON_SECRET=

# Required for private attachment uploads/downloads.
BLOB_READ_WRITE_TOKEN=

# Required for OCR extraction.
ANTHROPIC_API_KEY=
